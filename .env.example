APP_NAME=barbershop-platform
APP_ENV=local
# Public checkout POSTs, including accepted retries, require an explicit opening.
SHOP_CHECKOUT_ENABLED=false
SHOP_CHECKOUT_PILOT_ENABLED=false
SHOP_CHECKOUT_PILOT_CUSTOMER_IDS=
SHOP_NP_RETURNS_ENABLED=false
SHOP_NP_RETURN_LIVE_TRANSPORT_ENABLED=false
SHOP_NP_RETURN_PROFILE=null
SHOP_NP_RETURN_API_KEY=
SHOP_PAYMENTS_ENABLED=false
SHOP_PAYMENT_MANUAL_POLICY=null
SHOP_MONOBANK_LIVE_TRANSPORT_ENABLED=false
SHOP_MONOBANK_PROFILE=null
SHOP_MONOBANK_TOKEN=
SHOP_ORDER_OPERATIONS_ENABLED=false
SHOP_FISCAL_MOCK_ENABLED=false
SHOP_CARRIER_RETURNS_MOCK_ENABLED=false
SHOP_CHECKBOX_ENABLED=false
SHOP_CHECKBOX_LIVE_TRANSPORT_ENABLED=false
# Explicit approved server profile required; no default tax or tender regime.
SHOP_CHECKBOX_PROFILE=null
SHOP_CHECKBOX_LOGIN=
SHOP_CHECKBOX_PASSWORD=
SHOP_CHECKBOX_LICENSE_KEY=
# Local isolated mock Checkbox only; never enables a real fiscal provider.
CHECKBOX_MOCK_ENABLED=false
# Provider sandbox is separate from local mocks. No provider requests by default.
PROVIDER_SANDBOX_ENABLED=false
SANDBOX_PROVIDER_NETWORK_ENABLED=false
# Dedicated test token obtained at https://api.monobank.ua/ (never a live token).
# Monobank has no documented API test-mode flag. SHA256 + source + confirmation
# pin operator-verified provenance; they are NOT provider proof of sandbox mode.
SANDBOX_MONOBANK_TOKEN=
SANDBOX_MONOBANK_TOKEN_SHA256=
SANDBOX_MONOBANK_TOKEN_SOURCE=
SANDBOX_MONOBANK_TEST_TOKEN_CONFIRMED=false
SANDBOX_CHECKBOX_LOGIN=
SANDBOX_CHECKBOX_PASSWORD=
SANDBOX_CHECKBOX_LICENSE_KEY=
# Pin all three UUIDs from the dedicated Checkbox TEST cashier/register.
SANDBOX_CHECKBOX_CASH_REGISTER_ID=
SANDBOX_CHECKBOX_CASHIER_ID=
SANDBOX_CHECKBOX_ORGANIZATION_ID=
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
API_WORKERS=1
# Preserve current barber automation; false is an explicitly assigned API-only replica.
BACKGROUND_WORKERS_ENABLED=true
CUSTOMER_ACTIVITY_NOTIFICATION_SCHEDULER_ENABLED=true
BACKGROUND_OWNER_HEARTBEAT_SECONDS=5
# Exact proxy peers/networks; never wildcard or /0. Validate the real proxy chain.
TRUSTED_PROXY_IPS=127.0.0.1
# Local/development/test opt-in only; production/staging always enforce PostgreSQL limits.
SHARED_INGRESS_LIMITS_ENABLED=false
OTP_SOURCE_SEND_LIMIT=5
OTP_SOURCE_VERIFY_LIMIT=20
CHECKOUT_SOURCE_LIMIT=30
SOURCE_LIMIT_WINDOW_SECONDS=60
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKOFFICE_REFRESH_TOKEN_EXPIRE_DAYS=7
CUSTOMER_ACCESS_TOKEN_EXPIRE_DAYS=30
OTP_CODE_TTL_MINUTES=10
OTP_RESEND_INTERVAL_SECONDS=120
OTP_MAX_SENDS_PER_DAY=3
OTP_MAX_VERIFY_ATTEMPTS_PER_DAY=5

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=barbershop_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003,http://localhost:3004,http://127.0.0.1:3004,http://localhost:4040,http://127.0.0.1:4040,http://localhost:3010,http://127.0.0.1:3010,http://localhost:8000,http://127.0.0.1:8000,http://localhost:6060,http://127.0.0.1:6060

AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SMS_PROVIDER=stub
# All processes using an SMSClub account must share this key and PostgreSQL DB.
SMS_CLUB_ACCOUNT_KEY=primary
# SMSClub ceiling9 requests/sec;8 leaves account-wide headroom.
SMS_CLUB_REQUESTS_PER_SECOND=8
SMS_QUEUE_WORKER_ENABLED=true
SMS_QUEUE_POLL_SECONDS=0.1
SMS_QUEUE_BATCH_SIZE=50
SMS_QUEUE_CONCURRENCY=2
SMS_CAMPAIGN_RECIPIENTS_PER_MINUTE=60
SMS_QUEUE_MAX_ATTEMPTS=5
SMS_QUEUE_RETRY_BASE_SECONDS=1
SMS_QUEUE_RETRY_MAX_SECONDS=60
SMS_QUEUE_LEASE_SECONDS=30
SMS_QUEUE_WAIT_SECONDS=30
SMS_QUEUE_TTL_MINUTES=1440
SMS_SENDER_NAME=Soul Cuts
SMS_CLUB_TOKEN=
SMS_CLUB_BASE_URL=https://im.smsclub.mobi
SMS_DELIVERY_STATUS_SCHEDULER_ENABLED=true
SMS_DELIVERY_STATUS_POLL_INTERVAL_SECONDS=60
SMS_DELIVERY_STATUS_MAX_AGE_HOURS=48
SMS_OTP_TEMPLATE=Ваш код для входу в Soul Cuts: {code}. Нікому його не повідомляйте.
BOOKING_SMS_NOTIFICATIONS_ENABLED=false
BOOKING_AUTO_COMPLETION_ENABLED=true
# Do not automatically complete historical bookings before this Kyiv date.
BOOKING_AUTO_COMPLETION_STARTS_ON=2026-10-11
BOOKING_AUTO_COMPLETION_INTERVAL_SECONDS=60
BOOKING_SMS_REMINDERS_ENABLED=false
BOOKING_SMS_TWO_HOUR_REMINDERS_ENABLED=true
BOOKING_SMS_TWO_HOUR_REMINDER_LEAD_HOURS=2
BOOKING_SMS_TWO_HOUR_REMINDER_WINDOW_MINUTES=30
BOOKING_SMS_CONFIRMATION_TEMPLATE=Ви записані до майстра {master_name} на {appointment_date} о {appointment_time}. Чекаємо у {barbershop_name}.
BOOKING_SMS_TWO_HOUR_REMINDER_TEMPLATE=Нагадуємо, сьогодні о {appointment_time} у вас візит до майстра {master_name}. Будемо раді бачити вас у {barbershop_name}.

EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
FEEDBACK_RECIPIENT_EMAIL=
SMTP_FROM_NAME=Soulcuts
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

BREVO_SYNC_ENABLED=false
BREVO_API_KEY=
BREVO_CONTACT_LIST_ID=5
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_TIMEOUT_SECONDS=10

GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_BUSINESS_REVIEWS_CACHE_TTL_DAYS=30
GOOGLE_BUSINESS_REVIEWS_PAGE_SIZE=50
GOOGLE_BUSINESS_REVIEWS_MAX_PAGES=5
GOOGLE_BUSINESS_REVIEWS_ORDER_BY=updateTime desc

NOVA_POSHTA_API_KEY=
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/
NOVA_POSHTA_TIMEOUT_SECONDS=10

PRODUCT_TOP_SCHEDULER_ENABLED=true
PRODUCT_TOP_CHECK_INTERVAL_DAYS=7
PRODUCT_TOP_REFRESH_INTERVAL_DAYS=30
PRODUCT_TOP_WINDOW_DAYS=30
PRODUCT_TOP_FRACTION=0.1
PRODUCT_TOP_MAX_PRODUCTS=8
PRODUCT_TOP_MIN_UNIQUE_VIEWS=30
PRODUCT_TOP_MIN_PAID_ORDERS=3
PRODUCT_VIEW_RETENTION_DAYS=90
SERVICE_POPULARITY_SCHEDULER_ENABLED=true
SERVICE_POPULARITY_CHECK_INTERVAL_DAYS=7
SERVICE_POPULARITY_REFRESH_INTERVAL_DAYS=30
SERVICE_POPULARITY_WINDOW_DAYS=30

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SoulcutsBot
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_SEND_TIMEOUT_SECONDS=10
TELEGRAM_WEBHOOK_SECRET=
REPEAT_BOOKING_SCHEDULER_ENABLED=true
REPEAT_BOOKING_SCHEDULER_INTERVAL_SECONDS=60
MASTER_SCHEDULE_REMINDER_SCHEDULER_ENABLED=true
MASTER_SCHEDULE_REMINDER_SCHEDULER_INTERVAL_SECONDS=300
REPEAT_BOOKING_DELAY_DAYS=28
# Optional JSON map of barber-service id to cadence days, e.g. {"12":21,"19":35}
REPEAT_BOOKING_SERVICE_DELAY_DAYS={}
REPEAT_BOOKING_FREQUENCY_CAP_DAYS=30
REPEAT_BOOKING_TOKEN_TTL_DAYS=30
REPEAT_BOOKING_PUBLIC_PATH=/booking/repeat
REPEAT_BOOKING_QUIET_HOURS_FROM=20:00
REPEAT_BOOKING_QUIET_HOURS_TO=10:00
PUBLIC_API_BASE_URL=https://api.soulcuts.com.ua
PUBLIC_SITE_URL=https://soulcuts.com.ua
BACKOFFICE_URL=https://admin.soulcuts.com.ua
CUSTOMER_ACTIVITY_BROWSER_SESSION_TTL_DAYS=30
# Enable only after validating scheduled campaign runs with sandbox providers.
# Campaign offers: enable only after rollout verification; does not launch drafts.
CAMPAIGN_RUN_SCHEDULER_ENABLED=false
CAMPAIGN_RUN_SCHEDULER_INTERVAL_SECONDS=30
MESSAGING_MAX_RETRY_ATTEMPTS=3
MESSAGING_RETRY_DELAY_MINUTES=15
MESSAGING_BATCH_SIZE=50
MESSAGING_DEFAULT_REVIEW_URL=
REVIEW_REQUEST_DELAY_MINUTES=120
REVIEW_REQUEST_LOOKBACK_HOURS=24
REVIEW_TOKEN_TTL_DAYS=14
REVIEW_COMMENT_MAX_LENGTH=2000
REVIEW_FREQUENCY_CAP_DAYS=90
REVIEW_SUBMITTED_FREQUENCY_CAP_DAYS=270
REVIEW_QUIET_HOURS_FROM=21:00
REVIEW_QUIET_HOURS_TO=09:00
REVIEW_REQUEST_SCHEDULER_ENABLED=true
REVIEW_REQUEST_SCHEDULER_INTERVAL_SECONDS=60
REVIEW_VALIDATION_RATE_LIMIT=30
REVIEW_SUBMISSION_RATE_LIMIT=5
REVIEW_PUBLIC_AUTHOR_NAMES_ENABLED=false
REVIEW_PUBLIC_PATH=/masters
BARBERSHOP_NAME=Soul Cuts

BOOKING_FUNNEL_HASH_SECRET=
BOOKING_FUNNEL_EVENT_RATE_LIMIT=120
BOOKING_FUNNEL_DIGEST_SCHEDULER_ENABLED=true
BOOKING_FUNNEL_DIGEST_SCHEDULER_INTERVAL_SECONDS=3600
BOOKING_FUNNEL_NO_SLOT_ALERT_MIN_COUNT=3
BOOKING_FUNNEL_NO_SLOT_ALERT_RATE_PERCENT=20
BOOKING_FUNNEL_STALE_SCHEDULE_ALERT_COUNT=1
BOOKING_FUNNEL_ERROR_ALERT_COUNT=1
BOOKING_FUNNEL_MEANINGFUL_STEP_SESSIONS=5

# Nova Poshta: server-side key, daily atomic directory refresh; failed polls retry hourly.
NOVA_POSHTA_DIRECTORY_ENABLED=true
NOVA_POSHTA_DIRECTORY_REFRESH_HOURS=24
NOVA_POSHTA_DIRECTORY_POLL_SECONDS=3600

# Real read-only tracking: disabled until migration + explicitly verified waybills.
NP_TRACKING_ENABLED=false
NP_TRACKING_POLL_SECONDS=60
NP_TRACKING_INTERVAL_SECONDS=1800
NP_TRACKING_COOLDOWN_SECONDS=300
NP_TRACKING_STALE_SECONDS=7200
NP_TRACKING_BATCH_SIZE=100
NP_TRACKING_REQUEST_INTERVAL_SECONDS=2
NP_TRACKING_MAX_BACKOFF_SECONDS=86400
NP_TRACKING_TERMINAL_INTERVAL_SECONDS=86400

# Local isolated PostgreSQL test DB only; no real ETTN provider contract.
CHECKBOX_ETTN_MOCK_ENABLED=false

# Isolated local PostgreSQL test database only; no bank/provider traffic.
MONOBANK_QR_MOCK_ENABLED=false

# R4 explicit cancellation/reconciliation; no provider writes or automatic fiscal operation.
SHOP_PAYMENT_RESOLUTIONS_ENABLED=false
SHOP_PAYMENT_RESOLUTION_MANUAL_POLICY=null

# Sentry is disabled while SENTRY_DSN is empty (keep it empty locally to save quota).
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_EVENT_THROTTLE_SECONDS=600
